# DB (로컬 PostgreSQL. docker compose를 쓰면 아래 주석 값)
DATABASE_URL=postgresql+psycopg:///chainbuy
# DATABASE_URL=postgresql+psycopg://chainbuy:chainbuy@localhost:5432/chainbuy

# 서버
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
RPC_URL=http://127.0.0.1:8545
# CHAINBUY_ADDRESS=0x...   # 없으면 blockchain/deployments/localhost.json

# JWT — 배포할 때는 반드시 긴 무작위 값으로 (예: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_TTL_SECONDS=43200

# 개발용 가짜 OAuth (배포 시 false)
ENABLE_MOCK_OAUTH=true

# AI 구매 에이전트 (python -m app.agent)
# AGENT_KEY=0x...                  # 없으면 hardhat 테스트 계정 #2 (로컬 전용)
# RUN_AGENT_IN_API=false           # true면 API 서버 안에서 에이전트도 같이 실행
MOCK_URL=http://localhost:4100
# LLM으로 상품 화면 읽기. 비워 두면 규칙 기반으로 읽는다
LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5-5      # 더 싸게: claude-haiku-5-5

# YouTube (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Instagram (프로페셔널 계정)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Threads
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
