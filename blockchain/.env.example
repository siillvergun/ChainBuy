# Sepolia 배포용 (테스트넷 전용 지갑만 쓰세요)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<키>
DEPLOYER_PRIVATE_KEY=0x...
# 선택: 컨트랙트 소스 검증
ETHERSCAN_API_KEY=

# 배포 후 역할을 줄 주소 (비우면 배포 지갑)
REVIEWER_ADDRESS=
AGENT_ADDRESS=
FEE_RECIPIENT=
# mock 카드 발급사 지갑 (허용 쇼핑몰 demo-mall의 카드 충전 주소)
CARD_ISSUER_ADDRESS=
# 계정 추상화: 백엔드 가스 대납 서명 + 번들러 지갑 주소 (backend SPONSOR_KEY의 주소)
SPONSOR_ADDRESS=
# Paymaster에 맡길 가스비 (Sepolia ETH)
PAYMASTER_DEPOSIT_ETH=0.05
